diff --git a/breakwater/apps/netbench/src/Makefile.parity b/breakwater/apps/netbench/src/Makefile.parity
new file mode 100644
index 0000000..e61d345
--- /dev/null
+++ b/breakwater/apps/netbench/src/Makefile.parity
@@ -0,0 +1,28 @@
+# Hardcoded and compiler-generated control around the same netbench work.
+MODE ?= hardcoded
+DC_ROOT ?= $(abspath $(ROOT_PATH)/../..)
+DC_CXX ?= $(DC_ROOT)/build/llvm/bin/clang++
+BUILD_PATH := ../build-parity/$(MODE)
+include Makefile
+INC += -I$(DC_ROOT)/runtime
+
+ifeq ($(filter $(MODE),hardcoded auto),)
+$(error MODE must be hardcoded or auto)
+endif
+CXX := $(DC_CXX)
+LDXX := $(DC_CXX)
+# The AMD test machine has neither AVX-512 nor user interrupts.
+FLAGS := $(filter-out -mavx512f -muintr -flto,$(FLAGS)) -march=znver2
+LDFLAGS := $(filter-out -flto,$(LDFLAGS))
+ifeq ($(MODE),auto)
+$(BUILD_PATH)/memory_control.o: CXXFLAGS += -DNETBENCH_DC_AUTO -mllvm -dc-enable
+lib_obj += $(BUILD_PATH)/dynamic_control.o
+endif
+
+.DEFAULT_GOAL := parity
+.PHONY: parity
+parity: $(netbench_tgt)
+$(netbench_tgt): $(lib_obj)
+$(BUILD_PATH)/dynamic_control.o: $(DC_ROOT)/runtime/dynamic_control.cc $(DC_ROOT)/runtime/dynamic_control.h
+	@mkdir -p $(BUILD_PATH)
+	$(CXX) $(CXXFLAGS) -c $< -o $@
diff --git a/breakwater/apps/netbench/src/memory_control.cc b/breakwater/apps/netbench/src/memory_control.cc
new file mode 100644
index 0000000..8c779c1
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control.cc
@@ -0,0 +1,65 @@
+#include "memory_control.h"
+#include "synthetic_worker.h"
+#include "m_semaphore.hpp"
+
+extern "C" {
+#include <runtime/thread.h>
+}
+
+#ifdef NETBENCH_DC_AUTO
+#include "dynamic_control.h"
+#endif
+
+namespace {
+MemSemaphore *semaphore;
+#ifdef NETBENCH_DC_AUTO
+const DcFunction *descriptor;
+#endif
+
+void Acquire() noexcept {
+  semaphore->Wait();
+}
+
+void Release() noexcept {
+  semaphore->Post();
+}
+}  // namespace
+
+#ifdef NETBENCH_DC_AUTO
+extern "C" void dc_acquire(const DcFunction *) noexcept { Acquire(); }
+extern "C" void dc_release(const DcFunction *) noexcept { Release(); }
+#define MEMORY_BOUNDARY __attribute__((annotate("dc"), noinline))
+#else
+#define MEMORY_BOUNDARY __attribute__((noinline))
+#endif
+
+extern "C" MEMORY_BOUNDARY void
+netbench_memory_work(SyntheticWorker **workers, uint64_t iterations) noexcept {
+#ifndef NETBENCH_DC_AUTO
+  if (semaphore) Acquire();
+#endif
+  workers[get_current_affinity()]->Work(iterations);
+#ifndef NETBENCH_DC_AUTO
+  if (semaphore) Release();
+#endif
+}
+
+bool NetbenchMemoryControlInit(bool enabled) noexcept {
+  semaphore = enabled ? MemSemaphore::GetInstance() : nullptr;
+#ifdef NETBENCH_DC_AUTO
+  descriptor = dc_find("netbench_memory_work");
+  if (!descriptor) return false;  // Never silently run an unprepared build.
+  if (enabled) dc_enable(descriptor);
+  else dc_disable(descriptor);
+#endif
+  return true;
+}
+
+const char *NetbenchMemoryControlMode() noexcept {
+#ifdef NETBENCH_DC_AUTO
+  return "autoinstrumented";
+#else
+  return "hardcoded";
+#endif
+}
+
diff --git a/breakwater/apps/netbench/src/memory_control.h b/breakwater/apps/netbench/src/memory_control.h
new file mode 100644
index 0000000..954eecc
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstdint>
+
+class SyntheticWorker;
+
+// Called inside Shenango, before request threads start. Both builds use the
+// existing MemSemaphore singleton; the auto build also publishes its guard.
+bool NetbenchMemoryControlInit(bool enabled) noexcept;
+const char *NetbenchMemoryControlMode() noexcept;
+
+// workers is indexed after acquisition, because Wait may migrate the thread.
+extern "C" void netbench_memory_work(SyntheticWorker **workers,
+                                      uint64_t iterations) noexcept;
+
