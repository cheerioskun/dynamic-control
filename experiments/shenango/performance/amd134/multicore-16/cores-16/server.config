# One scheduler thread forces the real semaphore to capacity one.
# The existing no-PCI iokernel on amd134 provides the shared network backend.
host_addr 192.168.11.10
host_netmask 255.255.255.0
host_gateway 192.168.11.254
runtime_kthreads 16
runtime_spinning_kthreads 16
runtime_guaranteed_kthreads 16
runtime_priority lc
