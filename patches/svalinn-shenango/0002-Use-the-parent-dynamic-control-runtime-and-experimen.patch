diff --git a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc
deleted file mode 100644
index 8412624facb3b3cf6dfb5de51826872e5b08a41d..0000000000000000000000000000000000000000
--- a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc
+++ /dev/null
@@ -1,46 +0,0 @@
-#include "dynamic_control.h"
-
-#include <cstring>
-#include <type_traits>
-
-static_assert(std::is_standard_layout_v<DcFunction>);
-static_assert(sizeof(DcEntry) == sizeof(void *));
-static_assert(sizeof(DcFunction) == 4 * sizeof(void *));
-static_assert(offsetof(DcFunction, body) == sizeof(void *));
-static_assert(offsetof(DcFunction, guard) == 2 * sizeof(void *));
-static_assert(offsetof(DcFunction, target) == 3 * sizeof(void *));
-static_assert(sizeof(DcModule) == 3 * sizeof(void *));
-static_assert(offsetof(DcModule, count) == sizeof(void *));
-static_assert(offsetof(DcModule, next) == 2 * sizeof(void *));
-static_assert(__atomic_always_lock_free(sizeof(DcEntry), nullptr));
-
-namespace {
-// Module constructors register their tables before main.
-DcModule *modules = nullptr;
-}
-
-extern "C" void __dc_register_module(DcModule *module) noexcept {
-  module->next = modules;
-  modules = module;
-}
-
-extern "C" const DcFunction *dc_find(const char *name) noexcept {
-  for (auto *module = modules; module; module = module->next) {
-    for (size_t i = 0; i < module->count; ++i) {
-      const auto *function = &module->functions[i];
-      if (std::strcmp(name, function->name) == 0)
-        return function;
-    }
-  }
-  return nullptr;
-}
-
-extern "C" void dc_enable(const DcFunction *function) noexcept {
-  // Match compiler-emitted LLVM atomic pointer loads without pretending the
-  // compiler's raw pointer global is a constructed std::atomic object.
-  __atomic_store_n(function->target, function->guard, __ATOMIC_RELEASE);
-}
-
-extern "C" void dc_disable(const DcFunction *function) noexcept {
-  __atomic_store_n(function->target, function->body, __ATOMIC_RELEASE);
-}
diff --git a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h
deleted file mode 100644
index 64b43427551c0a493ce6cca4176328dd7790c23c..0000000000000000000000000000000000000000
--- a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h
+++ /dev/null
@@ -1,53 +0,0 @@
-#ifndef DYNAMIC_CONTROL_H
-#define DYNAMIC_CONTROL_H
-
-#include <stddef.h>
-#include <stdbool.h>
-
-#ifdef __cplusplus
-#define DC_NOEXCEPT noexcept
-extern "C" {
-#else
-#define DC_NOEXCEPT
-#endif
-
-// Erased addresses are stored, never called through this type. Dispatchers
-// restore the original signature. Slot accesses must always be atomic.
-typedef void (*DcEntry)(void);
-
-// Compiler ABI: four pointer-sized fields, in this order. Descriptors are
-// immutable; each target points to a separate, pointer-aligned writable slot.
-typedef struct DcFunction {
-  const char *name;
-  DcEntry body;
-  DcEntry guard;
-  DcEntry *target;
-} DcFunction;
-
-// One registration node per module, linked by its constructor before main.
-// Nodes and descriptors live until exit.
-typedef struct DcModule {
-  const DcFunction *functions;
-  size_t count;
-  struct DcModule *next;
-} DcModule;
-
-void __dc_register_module(DcModule *module) DC_NOEXCEPT;
-
-// Exact, unique LLVM/linkage names. Missing names return NULL.
-// Call after startup registration. Handles remain valid until exit.
-const DcFunction *dc_find(const char *name) DC_NOEXCEPT;
-// Require a non-null handle returned by dc_find. Future entries select the
-// published destination; calls racing with a toggle can take either path.
-void dc_enable(const DcFunction *function) DC_NOEXCEPT;
-void dc_disable(const DcFunction *function) DC_NOEXCEPT;
-
-// Netbench's backend uses the existing blocking MemSemaphore singleton.
-void dc_acquire(const DcFunction *function) DC_NOEXCEPT;
-void dc_release(const DcFunction *function) DC_NOEXCEPT;
-
-#ifdef __cplusplus
-}
-#endif
-#undef DC_NOEXCEPT
-#endif
