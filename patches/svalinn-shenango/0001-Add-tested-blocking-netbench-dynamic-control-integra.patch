diff --git a/breakwater/apps/netbench/src/run_parity.py b/breakwater/apps/netbench/src/run_parity.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd9cb7ce39fc9866a2426a53bb95ba68f818478b
--- /dev/null
+++ b/breakwater/apps/netbench/src/run_parity.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Run on the Linux test host after building both modes with VERIFY=0 and 1.
+
+Uses the already-running no-PCI iokernel. No daemon or machine setup is changed.
+The network smoke test uses a Linux-socket client, not a benchmark rig.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+SRC = Path(__file__).resolve().parent
+BUILD = SRC.parent / "build-parity"
+
+
+def record_manifest(output):
+    root = SRC.parents[3]
+    files = [SRC / name for name in ["netbench.cc", "memory_control.cc",
+             "memory_control.h", "memory_control_test.cc", "synthetic_worker.cc",
+             "synthetic_worker.h", "Makefile.parity",
+             "dynamic_control/dynamic_control.cc", "dynamic_control/dynamic_control.h"]]
+    files += [root / name for name in ["libruntime.a", "libnet.a", "libbase.a",
+              "bindings/cc/librt++.a", "breakwater/libbw.a",
+              "breakwater/bindings/cc/libbw++.a", "m-semaphore/build/libmsem.a"]]
+    files += [BUILD / f"{mode}-verify{verify}" / target
+              for mode in ["hardcoded", "auto"] for verify, target in
+              [(0, "netbench"), (1, "memory_control_test")]]
+    manifest = {"uname": subprocess.check_output(["uname", "-a"], text=True).strip(),
+                "files_sha256": {str(p.relative_to(root)):
+                    hashlib.sha256(p.read_bytes()).hexdigest() for p in files}}
+    (output / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+
+
+def run(args, cwd, log, timeout):
+    with log.open("w") as output:
+        subprocess.run(args, cwd=cwd, stdout=output,
+                       stderr=subprocess.STDOUT, timeout=timeout, check=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    record_manifest(output)
+    config = SRC / "parity-test.config"
+    for mode, state in [("hardcoded", "enabled"), ("auto", "enabled"),
+                        ("hardcoded", "disabled"), ("auto", "disabled"),
+                        ("auto", "toggle")]:
+        log = output / f"{mode}-{state}.log"
+        run(["sudo", "-n", "timeout", "25s",
+             str(BUILD / f"{mode}-verify1" / "memory_control_test"),
+             str(config), state], output, log, 30)
+        lines = [line for line in log.read_text().splitlines()
+                 if line.startswith("PASS ")]
+        if len(lines) != 1:
+            raise RuntimeError(f"missing PASS: {log}")
+        print(lines[0], flush=True)
+
+    network_results = []
+    for mode in ["hardcoded", "auto"]:
+        folder = output / f"network-{mode}"
+        folder.mkdir()
+        binary = BUILD / f"{mode}-verify0" / "netbench"
+        with (folder / "server.log").open("w") as server_log:
+            server = subprocess.Popen(
+                ["sudo", "-n", "timeout", "35s", str(binary), "nocontrol",
+                 str(config), "server", "msem"], cwd=folder,
+                stdout=server_log, stderr=subprocess.STDOUT)
+            try:
+                time.sleep(1)
+                if server.poll() is not None:
+                    raise RuntimeError(f"server exited: {folder}")
+                # A Linux-socket client reaches the existing no-PCI iokernel
+                # through dtap0, avoiding cross-process hairpin routing.
+                run([sys.executable, str(SRC / "netbench_wire_smoke.py"),
+                     "192.168.11.10"],
+                    folder, folder / "client.log", 30)
+            finally:
+                # Kill only this script's server, via timeout's process group
+                # leader; sudo forwards SIGTERM to its child timeout.
+                server.terminate()
+                try:
+                    server.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    server.kill()
+                    server.wait()
+        result = json.loads((folder / "client.log").read_text())
+        network_results.append(result)
+        print(f"network {mode}: {json.dumps(result, sort_keys=True)}", flush=True)
+    if network_results[0] != network_results[1]:
+        raise RuntimeError("hardcoded and auto response results differ")
+    print("PASS: hardcoded and auto network response fields match", flush=True)
+
+
+if __name__ == "__main__":
+    main()
