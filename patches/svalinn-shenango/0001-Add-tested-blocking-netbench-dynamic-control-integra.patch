+++ b/breakwater/apps/netbench/src/Makefile.parity
@@ -0,0 +1,57 @@
+# Use one patched compiler and identical application flags for both modes.
+# Existing Shenango and semaphore archives remain unchanged.
+MODE ?= hardcoded
+VERIFY ?= 0
+DC_CXX ?= $(HOME)/dynamic-control/build/llvm/bin/clang++
+BUILD_PATH := ../build-parity/$(MODE)-verify$(VERIFY)
+include Makefile
+
+ifeq ($(filter $(MODE),hardcoded auto),)
+$(error MODE must be hardcoded or auto)
+endif
+CXX := $(DC_CXX)
+LDXX := $(DC_CXX)
+# The CloudLab Zen 2 machine has neither AVX-512 nor user interrupts.
+FLAGS := $(filter-out -mavx512f -muintr -flto,$(FLAGS)) -march=znver2
+LDFLAGS := $(filter-out -flto,$(LDFLAGS))
+ifeq ($(VERIFY),1)
+CXXFLAGS += -DNETBENCH_DC_VERIFY
+endif
+ifeq ($(MODE),auto)
+$(BUILD_PATH)/memory_control.o: CXXFLAGS += -DNETBENCH_DC_AUTO -mllvm -dc-enable
+lib_obj += $(BUILD_PATH)/dynamic_control.o
+endif
+
+# Extra prerequisites are added after Makefile's original rules.
+$(netbench_tgt): $(lib_obj)
+$(BUILD_PATH)/dynamic_control.o: dynamic_control/dynamic_control.cc dynamic_control/dynamic_control.h
+	@mkdir -p $(BUILD_PATH)
+	$(CXX) $(CXXFLAGS) -c $< -o $@
+
+.PHONY: parity selftest ir bench
+parity: $(netbench_tgt)
+
+ifeq ($(VERIFY),0)
+bench: $(BUILD_PATH)/memory_control_bench
+scaling: $(BUILD_PATH)/memory_control_scaling
+$(BUILD_PATH)/memory_control_scaling: $(BUILD_PATH)/memory_control_scaling.o $(lib_obj) $(librt) $(libmsem) $(libpcm) $(RUNTIME_DEPS)
+	$(LDXX) -o $@ $(LDFLAGS) $(filter %.o,$^) $(librt) $(libmsem) $(libpcm) $(RUNTIME_LIBS)
+$(BUILD_PATH)/memory_control_bench: $(BUILD_PATH)/memory_control_bench.o $(lib_obj) $(librt) $(libmsem) $(libpcm) $(RUNTIME_DEPS)
+	$(LDXX) -o $@ $(LDFLAGS) $(filter %.o,$^) $(librt) $(libmsem) $(libpcm) $(RUNTIME_LIBS)
+else
+bench:
+	$(error bench requires VERIFY=0)
+endif
+
+ifeq ($(VERIFY),1)
+selftest: $(BUILD_PATH)/memory_control_test
+$(BUILD_PATH)/memory_control_test: $(BUILD_PATH)/memory_control_test.o $(BUILD_PATH)/memory_control.o $(filter %/dynamic_control.o,$(lib_obj)) $(librt) $(libmsem) $(libpcm) $(RUNTIME_DEPS)
+	$(LDXX) -o $@ $(LDFLAGS) $(filter %.o,$^) $(librt) $(libmsem) $(libpcm) $(RUNTIME_LIBS)
+else
+selftest:
+	$(error selftest requires VERIFY=1)
+endif
+
+ir:
+	@mkdir -p $(BUILD_PATH)
+	$(CXX) $(CXXFLAGS) $(if $(filter auto,$(MODE)),-DNETBENCH_DC_AUTO -mllvm -dc-enable) -S -emit-llvm memory_control.cc -o $(BUILD_PATH)/memory_control.ll
