diff --git a/breakwater/apps/netbench/src/netbench_wire_smoke.py b/breakwater/apps/netbench/src/netbench_wire_smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..0dbea1b551ee8cc79609079da1955f8ca12885b9
--- /dev/null
+++ b/breakwater/apps/netbench/src/netbench_wire_smoke.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Small Linux-socket client for this revision's nocontrol/netbench wire ABI.
+
+This is a correctness probe, not a throughput benchmark. The server is the
+unchanged netbench RPC path. See breakwater/src/nc_proto.h and netbench.cc.
+"""
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+import socket
+import struct
+import sys
+
+HEADER = struct.Struct("<IIQQQ")
+PAYLOAD_SIZE = 72  # x86-64 C++ payload, including alignment padding
+CONNECTIONS = 4
+REQUESTS_PER_CONNECTION = 256
+BATCH = 16  # Below nocontrol's 64 outstanding slots per connection.
+
+
+def read_full(sock, size):
+    data = bytearray()
+    while len(data) < size:
+        part = sock.recv(size - len(data))
+        if not part:
+            raise RuntimeError("server closed before the full response")
+        data.extend(part)
+    return bytes(data)
+
+
+def connection(host, connection_id):
+    completed = {}
+    with socket.create_connection((host, 8123), timeout=5) as sock:
+        sock.settimeout(5)
+        sock.sendall(struct.pack("<i", 0))  # rpc_session_info.session_type
+        for batch in range(0, REQUESTS_PER_CONNECTION, BATCH):
+            pending = {}
+            wire = bytearray()
+            for offset in range(BATCH):
+                ident = connection_id * REQUESTS_PER_CONNECTION + batch + offset
+                payload = bytearray(PAYLOAD_SIZE)
+                struct.pack_into("<Q", payload, 0, 1)  # MEM_BOUND (native enum)
+                struct.pack_into(">QQ", payload, 8, 25, ident)  # work_itr, index
+                pending[ident] = bytes(payload[:24])
+                wire.extend(HEADER.pack(0x63727063, 0, PAYLOAD_SIZE, ident, 0))
+                wire.extend(payload)
+            sock.sendall(wire)
+            for _ in range(BATCH):
+                magic, op, size, ident, _ = HEADER.unpack(read_full(sock, HEADER.size))
+                if magic != 0x73727063 or op != 0 or size != PAYLOAD_SIZE:
+                    raise RuntimeError(f"invalid or dropped response: {(magic, op, size, ident)}")
+                response = read_full(sock, size)
+                expected = pending.pop(ident)
+                if response[:24] != expected:
+                    raise RuntimeError(f"request fields changed: {ident}")
+                capacity, = struct.unpack_from(">I", response, 64)
+                if capacity != 1:
+                    raise RuntimeError(f"expected capacity one, got {capacity}")
+                completed[ident] = response[:24]
+            if pending:
+                raise RuntimeError("missing responses")
+    return completed
+
+
+def main():
+    host = sys.argv[1]
+    with ThreadPoolExecutor(max_workers=CONNECTIONS) as pool:
+        results = list(pool.map(lambda i: connection(host, i), range(CONNECTIONS)))
+    completed = {key: value for result in results for key, value in result.items()}
+    if len(completed) != CONNECTIONS * REQUESTS_PER_CONNECTION:
+        raise RuntimeError("incorrect response count")
+    digest = hashlib.sha256(b"".join(completed[i] for i in sorted(completed))).hexdigest()
+    print(json.dumps({"requests": len(completed), "responses": len(completed),
+                      "connections": CONNECTIONS, "work_iterations": 25,
+                      "response_fields_sha256": digest}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
