@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Multicore correctness, concurrent worker throughput, then real netbench RPCs.
+
+No permit TLS. The original adaptive semaphore and counters are unchanged.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+
+SRC = Path(__file__).resolve().parent
+BUILD = SRC.parent / "build-parity"
+
+
+def run(command, log, timeout=30):
+    with log.open("w") as output:
+        subprocess.run(command, stdout=output, stderr=subprocess.STDOUT,
+                       timeout=timeout, check=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--source-commit", required=True)
+    parser.add_argument("--cores", type=int, nargs="+", default=[2, 4, 8])
+    parser.add_argument("--repetitions", type=int, default=5)
+    args = parser.parse_args()
+    out = args.output.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    files = [SRC / name for name in ["bench_multicore.py", "bench_netbench_rpc.py",
+        "memory_control_scaling.cc", "memory_control.cc", "memory_control.h",
+        "memory_control_test.cc", "Makefile.parity"]]
+    files += [BUILD / f"{mode}-verify{verify}" / target for mode in ["hardcoded", "auto"]
+              for verify, target in [(0, "netbench"), (0, "memory_control_scaling"),
+                                     (1, "memory_control_test")]]
+    manifest = {"source_commit": args.source_commit, "cores": args.cores,
+                "permit_tls": False, "repetitions": args.repetitions,
+                "lscpu": subprocess.check_output(["lscpu"], text=True),
+                "files_sha256": {str(p): hashlib.sha256(p.read_bytes()).hexdigest()
+                                 for p in files}}
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    summary = []
+    for cores in args.cores:
+        folder = out / f"cores-{cores}"
+        folder.mkdir()
+        config = folder / "server.config"
+        text = (SRC / "parity-test.config").read_text()
+        for key in ["runtime_kthreads", "runtime_spinning_kthreads", "runtime_guaranteed_kthreads"]:
+            text = text.replace(f"{key} 1", f"{key} {cores}")
+        config.write_text(text)
+        for mode in ["hardcoded", "auto"]:
+            log = folder / f"correctness-{mode}.log"
+            run(["sudo", "-n", "timeout", "25s",
+                 str(BUILD / f"{mode}-verify1" / "memory_control_test"),
+                 str(config), "multicore"], log)
+            if "PASS " not in log.read_text():
+                raise RuntimeError(f"missing correctness result: {log}")
+        print(f"{cores} cores: correctness passed", flush=True)
+        samples = []
+        for repetition in range(args.repetitions):
+            modes = ["hardcoded", "auto"] if repetition % 2 == 0 else ["auto", "hardcoded"]
+            for mode in modes:
+                log = folder / f"worker-{repetition:02d}-{mode}.log"
+                run(["sudo", "-n", "timeout", "20s",
+                     str(BUILD / f"{mode}-verify0" / "memory_control_scaling"),
+                     str(config)], log)
+                rows = [json.loads(line[8:]) for line in log.read_text().splitlines()
+                        if line.startswith("SCALING ")]
+                if len(rows) != 1 or rows[0]["scheduler_mask"].bit_count() != cores:
+                    raise RuntimeError(f"not all scheduler threads observed: {log}")
+                rows[0].update(variant=mode, repetition=repetition)
+                samples.extend(rows)
+            (folder / "worker-samples.json").write_text(json.dumps(samples, indent=2) + "\n")
+            print(f"{cores} cores: worker pair {repetition+1}/{args.repetitions}", flush=True)
+        hard = {s["repetition"]: s["calls_per_second"] for s in samples if s["variant"] == "hardcoded"}
+        auto = {s["repetition"]: s["calls_per_second"] for s in samples if s["variant"] == "auto"}
+        differences = [100 * (auto[i] / hard[i] - 1) for i in hard]
+        row = {"cores": cores, "hardcoded_worker_median_rps": statistics.median(hard.values()),
+               "auto_worker_median_rps": statistics.median(auto.values()),
+               "worker_paired_median_percent": statistics.median(differences),
+               "worker_paired_min_percent": min(differences),
+               "worker_paired_max_percent": max(differences)}
+        run([sys.executable, str(SRC / "bench_netbench_rpc.py"),
+             "--config", str(config), "--cores", str(cores),
+             "--source-commit", args.source_commit,
+             "--repetitions", str(args.repetitions), "--output", str(folder / "rpc")],
+            folder / "rpc-run.log", timeout=args.repetitions * 20 + 30)
+        row["rpc"] = json.loads((folder / "rpc/summary.json").read_text())
+        summary.append(row)
+        (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+        print(json.dumps(row), flush=True)
+
+
+if __name__ == "__main__":
+    main()
