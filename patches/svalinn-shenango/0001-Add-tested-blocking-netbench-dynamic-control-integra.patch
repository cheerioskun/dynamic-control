@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Closed-loop throughput through the real netbench server on the no-PCI path.
+
+Four Linux-socket clients each keep batches of 16 requests outstanding. This
+includes Python, kernel TCP, dtap, and the iokernel; it is not a NIC benchmark.
+"""
+import argparse
+import multiprocessing
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import socket
+import struct
+import subprocess
+import time
+
+from netbench_wire_smoke import HEADER, PAYLOAD_SIZE, read_full
+
+SRC = Path(__file__).resolve().parent
+BUILD = SRC.parent / "build-parity"
+
+
+def measure(seconds):
+    context = multiprocessing.get_context("fork")
+    barrier = context.Barrier(4)
+    results = context.Queue()
+
+    def client(index):
+        frames = bytearray()
+        expected = {}
+        for offset in range(16):
+            ident = index * 16 + offset
+            payload = bytearray(PAYLOAD_SIZE)
+            struct.pack_into("<Q", payload, 0, 1)
+            struct.pack_into(">QQ", payload, 8, 25, ident)
+            expected[ident] = bytes(payload[:24])
+            frames.extend(HEADER.pack(0x63727063, 0, PAYLOAD_SIZE, ident, 0))
+            frames.extend(payload)
+
+        def batch(sock):
+            sock.sendall(frames)
+            seen = set()
+            for _ in range(16):
+                magic, op, size, ident, _ = HEADER.unpack(read_full(sock, HEADER.size))
+                if magic != 0x73727063 or op != 0 or size != PAYLOAD_SIZE or ident in seen:
+                    raise RuntimeError("invalid, duplicate, or dropped response")
+                response = read_full(sock, size)
+                if response[:24] != expected[ident]:
+                    raise RuntimeError("response fields changed")
+                seen.add(ident)
+
+        with socket.create_connection(("192.168.11.10", 8123), timeout=5) as sock:
+            sock.settimeout(5)
+            sock.sendall(struct.pack("<i", 0))
+            for _ in range(10):
+                batch(sock)
+            barrier.wait(timeout=10)
+            cpu_start = time.process_time()
+            start = time.perf_counter()
+            deadline = start + seconds
+            count = 0
+            while time.perf_counter() < deadline:
+                batch(sock)
+                count += 16
+            return {"start": start, "end": time.perf_counter(), "responses": count,
+                    "client_cpu_s": time.process_time() - cpu_start}
+
+    def process(index):
+        try:
+            results.put(client(index))
+        except Exception as error:
+            results.put({"error": repr(error)})
+
+    processes = [context.Process(target=process, args=(index,)) for index in range(4)]
+    for child in processes:
+        child.start()
+    try:
+        rows = [results.get(timeout=seconds + 20) for _ in processes]
+        if any("error" in row for row in rows):
+            raise RuntimeError(rows)
+        for child in processes:
+            child.join(timeout=5)
+            if child.exitcode != 0:
+                raise RuntimeError("client process did not finish successfully")
+    finally:
+        for child in processes:
+            if child.is_alive():
+                child.terminate()
+            child.join(timeout=5)
+    elapsed = max(row["end"] for row in rows) - min(row["start"] for row in rows)
+    responses = sum(row["responses"] for row in rows)
+    return {"elapsed_s": elapsed, "responses": responses,
+            "responses_per_second": responses / elapsed,
+            "client_cpu_s": sum(row["client_cpu_s"] for row in rows)}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--source-commit", required=True)
+    parser.add_argument("--config", type=Path, default=SRC / "parity-test.config")
+    parser.add_argument("--cores", type=int, default=1)
+    parser.add_argument("--seconds", type=float, default=2)
+    parser.add_argument("--repetitions", type=int, default=7)
+    args = parser.parse_args()
+    out = args.output.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    files = [BUILD / f"{mode}-verify0" / "netbench" for mode in ["hardcoded", "auto"]]
+    files += [SRC / "bench_netbench_rpc.py", SRC / "netbench_wire_smoke.py",
+              args.config.resolve()]
+    manifest = {"source_commit": args.source_commit, "seconds": args.seconds,
+                "cores": args.cores, "client_processes": 4,
+                "repetitions": args.repetitions, "connections": 4, "batch": 16,
+                "work_iterations": 25, "enabled": True,
+                "files_sha256": {str(p):
+                    hashlib.sha256(p.read_bytes()).hexdigest() for p in files}}
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    samples = []
+    for repetition in range(args.repetitions):
+        modes = ["hardcoded", "auto"] if repetition % 2 == 0 else ["auto", "hardcoded"]
+        for mode in modes:
+            binary = BUILD / f"{mode}-verify0" / "netbench"
+            with (out / f"{repetition:02d}-{mode}.log").open("w") as log:
+                server = subprocess.Popen(["sudo", "-n", "timeout", "20s", str(binary),
+                    "nocontrol", str(args.config.resolve()), "server", "msem"],
+                    stdout=log, stderr=subprocess.STDOUT, cwd=out)
+                try:
+                    time.sleep(0.5)
+                    if server.poll() is not None:
+                        raise RuntimeError("server exited")
+                    result = measure(args.seconds)
+                finally:
+                    server.terminate()
+                    server.wait(timeout=5)
+            result.update(repetition=repetition, mode=mode)
+            samples.append(result)
+        (out / "samples.json").write_text(json.dumps(samples, indent=2) + "\n")
+        print(f"completed RPC pair {repetition + 1}/{args.repetitions}", flush=True)
+    hardcoded = {row["repetition"]: row["responses_per_second"] for row in samples
+                 if row["mode"] == "hardcoded"}
+    auto = {row["repetition"]: row["responses_per_second"] for row in samples
+            if row["mode"] == "auto"}
+    deltas = [100 * (auto[i] / hardcoded[i] - 1) for i in hardcoded]
+    summary = {"hardcoded_median_rps": statistics.median(hardcoded.values()),
+               "auto_median_rps": statistics.median(auto.values()),
+               "paired_median_percent": statistics.median(deltas),
+               "paired_min_percent": min(deltas), "paired_max_percent": max(deltas)}
+    (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/breakwater/apps/netbench/src/bench_parity.py b/breakwater/apps/netbench/src/bench_parity.py
new file mode 100644
index 0000000000000000000000000000000000000000..f5725d9890e1e6506a97bb9973ece5ed84f799c8
--- /dev/null
+++ b/breakwater/apps/netbench/src/bench_parity.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Repeated, alternating single-core measurements with real netbench work."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import subprocess
+
+SRC = Path(__file__).resolve().parent
+ROOT = SRC.parents[3]
+BUILD = SRC.parent / "build-parity"
+
+
+def sha256(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--source-commit", required=True)
+    parser.add_argument("--repetitions", type=int, default=9)
+    args = parser.parse_args()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    files = [SRC / name for name in ["memory_control_bench.cc", "memory_control.cc",
+             "memory_control.h", "synthetic_worker.cc", "synthetic_worker.h",
+             "Makefile.parity", "parity-test.config", "bench_parity.py",
+             "dynamic_control/dynamic_control.cc", "dynamic_control/dynamic_control.h"]]
+    files += [ROOT / name for name in ["libruntime.a", "libnet.a", "libbase.a",
+              "bindings/cc/librt++.a", "m-semaphore/build/libmsem.a",
+              "m-semaphore/deps/pcm/build/src/libpcm.a", "build/config", "build/shared.mk"]]
+    files += [BUILD / f"{mode}-verify0" / "memory_control_bench"
+              for mode in ["hardcoded", "auto"]]
+    manifest = {"source_commit": args.source_commit,
+                "repetitions": args.repetitions,
+                "files_sha256": {str(p.relative_to(ROOT)): sha256(p) for p in files}}
+    for command in [["uname", "-a"], ["lscpu"],
+                    [str(Path.home() / "dynamic-control/build/llvm/bin/clang++"), "--version"]]:
+        manifest[command[0]] = subprocess.check_output(command, text=True)
+    (output / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    samples = []
+    # Reverse each pair every repetition; rotate enabled/disabled order too.
+    for repetition in range(args.repetitions):
+        states = ["enabled", "disabled"] if repetition % 2 == 0 else ["disabled", "enabled"]
+        for state in states:
+            modes = ["hardcoded", "auto"] if repetition % 2 == 0 else ["auto", "hardcoded"]
+            for mode in modes:
+                binary = BUILD / f"{mode}-verify0" / "memory_control_bench"
+                log = output / f"{repetition:02d}-{mode}-{state}.log"
+                with log.open("w") as stream:
+                    subprocess.run(["sudo", "-n", "timeout", "20s", str(binary),
+                                    str(SRC / "parity-test.config"), state],
+                                   stdout=stream, stderr=subprocess.STDOUT,
+                                   timeout=25, check=True)
+                rows = [json.loads(line[6:]) for line in log.read_text().splitlines()
+                        if line.startswith("BENCH ")]
+                if len(rows) != 2:
+                    raise RuntimeError(f"missing benchmark output: {log}")
+                for row in rows:
+                    row.update(repetition=repetition, variant=mode)
+                samples.extend(rows)
+        (output / "samples.json").write_text(json.dumps(samples, indent=2) + "\n")
+        print(f"completed repetition {repetition + 1}/{args.repetitions}", flush=True)
+    summary = []
+    for enabled in [True, False]:
+        for iterations in [1, 25]:
+            selected = [s for s in samples if s["enabled"] == enabled and
+                        s["iterations"] == iterations]
+            hardcoded = {s["repetition"]: s["ns_per_call"] for s in selected
+                         if s["variant"] == "hardcoded"}
+            auto = {s["repetition"]: s["ns_per_call"] for s in selected
+                    if s["variant"] == "auto"}
+            ratios = [100 * (auto[i] / hardcoded[i] - 1) for i in hardcoded]
+            row = {"enabled": enabled, "iterations": iterations,
+                   "hardcoded_median_ns": statistics.median(hardcoded.values()),
+                   "auto_median_ns": statistics.median(auto.values()),
+                   "paired_median_percent": statistics.median(ratios),
+                   "paired_min_percent": min(ratios), "paired_max_percent": max(ratios)}
+            summary.append(row)
+    (output / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8412624facb3b3cf6dfb5de51826872e5b08a41d
--- /dev/null
+++ b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.cc
@@ -0,0 +1,46 @@
+#include "dynamic_control.h"
+
+#include <cstring>
+#include <type_traits>
+
+static_assert(std::is_standard_layout_v<DcFunction>);
+static_assert(sizeof(DcEntry) == sizeof(void *));
+static_assert(sizeof(DcFunction) == 4 * sizeof(void *));
+static_assert(offsetof(DcFunction, body) == sizeof(void *));
+static_assert(offsetof(DcFunction, guard) == 2 * sizeof(void *));
+static_assert(offsetof(DcFunction, target) == 3 * sizeof(void *));
+static_assert(sizeof(DcModule) == 3 * sizeof(void *));
+static_assert(offsetof(DcModule, count) == sizeof(void *));
+static_assert(offsetof(DcModule, next) == 2 * sizeof(void *));
+static_assert(__atomic_always_lock_free(sizeof(DcEntry), nullptr));
+
+namespace {
+// Module constructors register their tables before main.
+DcModule *modules = nullptr;
+}
+
+extern "C" void __dc_register_module(DcModule *module) noexcept {
+  module->next = modules;
+  modules = module;
+}
+
+extern "C" const DcFunction *dc_find(const char *name) noexcept {
+  for (auto *module = modules; module; module = module->next) {
+    for (size_t i = 0; i < module->count; ++i) {
+      const auto *function = &module->functions[i];
+      if (std::strcmp(name, function->name) == 0)
+        return function;
+    }
+  }
+  return nullptr;
+}
+
+extern "C" void dc_enable(const DcFunction *function) noexcept {
+  // Match compiler-emitted LLVM atomic pointer loads without pretending the
+  // compiler's raw pointer global is a constructed std::atomic object.
+  __atomic_store_n(function->target, function->guard, __ATOMIC_RELEASE);
+}
+
+extern "C" void dc_disable(const DcFunction *function) noexcept {
+  __atomic_store_n(function->target, function->body, __ATOMIC_RELEASE);
+}
diff --git a/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h
new file mode 100644
index 0000000000000000000000000000000000000000..64b43427551c0a493ce6cca4176328dd7790c23c
--- /dev/null
+++ b/breakwater/apps/netbench/src/dynamic_control/dynamic_control.h
@@ -0,0 +1,53 @@
+#ifndef DYNAMIC_CONTROL_H
+#define DYNAMIC_CONTROL_H
+
+#include <stddef.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+#define DC_NOEXCEPT noexcept
+extern "C" {
+#else
+#define DC_NOEXCEPT
+#endif
+
+// Erased addresses are stored, never called through this type. Dispatchers
+// restore the original signature. Slot accesses must always be atomic.
+typedef void (*DcEntry)(void);
+
+// Compiler ABI: four pointer-sized fields, in this order. Descriptors are
+// immutable; each target points to a separate, pointer-aligned writable slot.
+typedef struct DcFunction {
+  const char *name;
+  DcEntry body;
+  DcEntry guard;
+  DcEntry *target;
+} DcFunction;
+
+// One registration node per module, linked by its constructor before main.
+// Nodes and descriptors live until exit.
+typedef struct DcModule {
+  const DcFunction *functions;
+  size_t count;
+  struct DcModule *next;
+} DcModule;
+
+void __dc_register_module(DcModule *module) DC_NOEXCEPT;
+
+// Exact, unique LLVM/linkage names. Missing names return NULL.
+// Call after startup registration. Handles remain valid until exit.
+const DcFunction *dc_find(const char *name) DC_NOEXCEPT;
+// Require a non-null handle returned by dc_find. Future entries select the
+// published destination; calls racing with a toggle can take either path.
+void dc_enable(const DcFunction *function) DC_NOEXCEPT;
+void dc_disable(const DcFunction *function) DC_NOEXCEPT;
+
+// Netbench's backend uses the existing blocking MemSemaphore singleton.
+void dc_acquire(const DcFunction *function) DC_NOEXCEPT;
+void dc_release(const DcFunction *function) DC_NOEXCEPT;
+
+#ifdef __cplusplus
+}
+#endif
+#undef DC_NOEXCEPT
+#endif
diff --git a/breakwater/apps/netbench/src/memory_control.cc b/breakwater/apps/netbench/src/memory_control.cc
new file mode 100644
index 0000000000000000000000000000000000000000..63380a784618d684740c0c420ab91ca20f104fb0
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control.cc
@@ -0,0 +1,97 @@
+#include "memory_control.h"
+#include "synthetic_worker.h"
+#include "m_semaphore.hpp"
+
+extern "C" {
+#include <runtime/thread.h>
+}
+
+#ifdef NETBENCH_DC_AUTO
+#include "dynamic_control/dynamic_control.h"
+#endif
+#ifdef NETBENCH_DC_VERIFY
+#include <atomic>
+#endif
+
+namespace {
+MemSemaphore *semaphore;
+#ifdef NETBENCH_DC_AUTO
+const DcFunction *descriptor;
+#endif
+#ifdef NETBENCH_DC_VERIFY
+std::atomic<uint64_t> acquired{0}, released{0}, active{0};
+#endif
+
+void Acquire() noexcept {
+  semaphore->Wait();
+#ifdef NETBENCH_DC_VERIFY
+  acquired.fetch_add(1, std::memory_order_relaxed);
+  active.fetch_add(1, std::memory_order_relaxed);
+#endif
+}
+
+void Release() noexcept {
+#ifdef NETBENCH_DC_VERIFY
+  active.fetch_sub(1, std::memory_order_relaxed);
+  released.fetch_add(1, std::memory_order_relaxed);
+#endif
+  semaphore->Post();
+}
+}  // namespace
+
+#ifdef NETBENCH_DC_AUTO
+extern "C" void dc_acquire(const DcFunction *) noexcept { Acquire(); }
+extern "C" void dc_release(const DcFunction *) noexcept { Release(); }
+#define MEMORY_BOUNDARY __attribute__((annotate("dc"), noinline))
+#else
+#define MEMORY_BOUNDARY __attribute__((noinline))
+#endif
+
+extern "C" MEMORY_BOUNDARY void
+netbench_memory_work(SyntheticWorker **workers, uint64_t iterations) noexcept {
+#ifndef NETBENCH_DC_AUTO
+  if (semaphore) Acquire();
+#endif
+  workers[get_current_affinity()]->Work(iterations);
+#ifndef NETBENCH_DC_AUTO
+  if (semaphore) Release();
+#endif
+}
+
+bool NetbenchMemoryControlInit(bool enabled) noexcept {
+  semaphore = enabled ? MemSemaphore::GetInstance() : nullptr;
+#ifdef NETBENCH_DC_AUTO
+  descriptor = dc_find("netbench_memory_work");
+  if (!descriptor) return false;  // Never silently run an unprepared build.
+  if (enabled) dc_enable(descriptor);
+  else dc_disable(descriptor);
+#endif
+  return true;
+}
+
+const char *NetbenchMemoryControlMode() noexcept {
+#ifdef NETBENCH_DC_AUTO
+  return "autoinstrumented";
+#else
+  return "hardcoded";
+#endif
+}
+
+#ifdef NETBENCH_DC_VERIFY
+MemoryControlCounts NetbenchMemoryControlCounts() noexcept {
+  return {acquired.load(std::memory_order_relaxed),
+          released.load(std::memory_order_relaxed),
+          active.load(std::memory_order_relaxed)};
+}
+
+bool NetbenchMemoryControlSetEnabled(bool enabled) noexcept {
+#ifdef NETBENCH_DC_AUTO
+  if (!descriptor || !semaphore) return false;
+  if (enabled) dc_enable(descriptor);
+  else dc_disable(descriptor);
+  return true;
+#else
+  return false;
+#endif
+}
+#endif
