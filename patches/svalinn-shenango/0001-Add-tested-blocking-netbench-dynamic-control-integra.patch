diff --git a/breakwater/apps/netbench/src/memory_control_bench.cc b/breakwater/apps/netbench/src/memory_control_bench.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e80ff93b1e738ac518dc665b66d9f754741d50f2
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control_bench.cc
@@ -0,0 +1,58 @@
+// Time the actual netbench work boundary inside Shenango, without RPC/client
+// overhead or verification counters. Setup and calibration are outside timing.
+#include "memory_control.h"
+#include "synthetic_worker.h"
+#include "cc/runtime.h"
+#include "cc/sync.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <time.h>
+
+barrier_t barrier; // Referenced by an unused synthetic worker implementation.
+
+namespace {
+bool enabled;
+
+uint64_t Now() {
+  timespec t;
+  clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+  return uint64_t(t.tv_sec) * 1000000000 + t.tv_nsec;
+}
+
+uint64_t Batch(SyntheticWorker **workers, uint64_t iterations, uint64_t calls) {
+  uint64_t start = Now();
+  for (uint64_t i = 0; i < calls; ++i)
+    netbench_memory_work(workers, iterations);
+  return Now() - start;
+}
+
+void Run(void *) {
+  if (rt::RuntimeMaxCores() != 1 || !NetbenchMemoryControlInit(enabled))
+    std::exit(2);
+  SyntheticWorker *workers[NCPU]{};
+  workers[0] = SyntheticWorkerFactory("membwantagonist:32768:0:0");
+  if (!workers[0]) std::exit(2);
+  for (uint64_t iterations : {uint64_t(1), uint64_t(25)}) {
+    Batch(workers, iterations, 2000);
+    uint64_t calibration = Batch(workers, iterations, 2000);
+    uint64_t calls = std::clamp(uint64_t(300000000.0 * 2000 / calibration),
+                                uint64_t(5000), uint64_t(500000));
+    uint64_t elapsed = Batch(workers, iterations, calls);
+    printf("BENCH {\"mode\":\"%s\",\"enabled\":%s,\"iterations\":%lu,"
+           "\"calls\":%lu,\"elapsed_ns\":%lu,\"ns_per_call\":%.6f}\n",
+           NetbenchMemoryControlMode(), enabled ? "true" : "false",
+           iterations, calls, elapsed, double(elapsed) / calls);
+  }
+  std::exit(0);
+}
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 3 || (std::strcmp(argv[2], "enabled") &&
+                    std::strcmp(argv[2], "disabled"))) return 2;
+  enabled = !std::strcmp(argv[2], "enabled");
+  return runtime_init(argv[1], Run, nullptr);
+}
diff --git a/breakwater/apps/netbench/src/memory_control_scaling.cc b/breakwater/apps/netbench/src/memory_control_scaling.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e15a7e997ae6c49facef3dadb1fe1fd482520526
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control_scaling.cc
@@ -0,0 +1,73 @@
+// Concurrent real netbench workers under Shenango, without permit TLS.
+#include "memory_control.h"
+#include "synthetic_worker.h"
+#include "cc/runtime.h"
+#include "cc/sync.h"
+#include "cc/thread.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <time.h>
+
+barrier_t barrier;
+
+namespace {
+uint64_t Now() {
+  timespec t;
+  clock_gettime(CLOCK_MONOTONIC_RAW, &t);
+  return uint64_t(t.tv_sec) * 1000000000 + t.tv_nsec;
+}
+
+void Phase(SyntheticWorker **workers, int jobs, uint64_t duration, bool report) {
+  rt::WaitGroup ready(jobs), done(jobs);
+  rt::Semaphore start(0);
+  std::atomic<uint64_t> total{0}, scheduler_mask{0};
+  uint64_t deadline = 0;
+  for (int i = 0; i < jobs; ++i) {
+    rt::Spawn([&] {
+      ready.Done();
+      start.Wait();
+      uint64_t count = 0, mask = 0;
+      do {
+        netbench_memory_work(workers, 25);
+        mask |= uint64_t(1) << get_current_affinity();
+        ++count;
+      } while (Now() < deadline);
+      total.fetch_add(count, std::memory_order_relaxed);
+      scheduler_mask.fetch_or(mask, std::memory_order_relaxed);
+      done.Done();
+    });
+  }
+  ready.Wait();
+  uint64_t begin = Now();
+  deadline = begin + duration;
+  for (int i = 0; i < jobs; ++i) start.Post();
+  done.Wait();
+  uint64_t elapsed = Now() - begin;
+  if (report)
+    printf("SCALING {\"mode\":\"%s\",\"cores\":%d,\"jobs\":%d,"
+           "\"calls\":%lu,\"elapsed_ns\":%lu,\"calls_per_second\":%.6f,"
+           "\"scheduler_mask\":%lu}\n", NetbenchMemoryControlMode(),
+           rt::RuntimeMaxCores(), jobs, total.load(), elapsed,
+           double(total.load()) * 1e9 / elapsed, scheduler_mask.load());
+}
+
+void Run(void *) {
+  int cores = rt::RuntimeMaxCores();
+  if (cores < 1 || cores > 32 || !NetbenchMemoryControlInit(true)) std::exit(2);
+  SyntheticWorker *workers[NCPU]{};
+  for (int i = 0; i < cores; ++i) {
+    workers[i] = SyntheticWorkerFactory("membwantagonist:32768:0:0");
+    if (!workers[i]) std::exit(2);
+  }
+  Phase(workers, cores * 4, 1000000000, false);
+  Phase(workers, cores * 4, 2000000000, true);
+  std::exit(0);
+}
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 2) return 2;
+  return runtime_init(argv[1], Run, nullptr);
+}
diff --git a/breakwater/apps/netbench/src/memory_control_test.cc b/breakwater/apps/netbench/src/memory_control_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..aca0ce02ed30a1d2078ceab34e7c5f1b6f17f569
--- /dev/null
+++ b/breakwater/apps/netbench/src/memory_control_test.cc
@@ -0,0 +1,128 @@
+#include "memory_control.h"
+#include "synthetic_worker.h"
+#include "m_semaphore.hpp"
+#include "cc/runtime.h"
+#include "cc/thread.h"
+#include "cc/sync.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+constexpr int kThreads = 32;
+constexpr int kCalls = 20;
+bool enabled;
+bool multicore;
+bool toggle;
+bool expect_permit;
+std::atomic<uint64_t> calls{0}, sum{0};
+rt::Semaphore *entered, *resume;
+
+void Check(bool ok, const char *message) {
+  if (!ok) {
+    fprintf(stderr, "FAIL: %s\n", message);
+    std::exit(1);
+  }
+}
+
+class Worker : public SyntheticWorker {
+ public:
+  void Work(uint64_t n) override {
+    Check((expect_permit ? (NetbenchMemoryControlCounts().active >= 1 &&
+           NetbenchMemoryControlCounts().active <= uint64_t(rt::RuntimeMaxCores()))
+          : NetbenchMemoryControlCounts().active == 0),
+          "work sees the expected permit state");
+    if (toggle) {
+      entered->Post();
+      resume->Wait();
+    } else {
+      // Yield while holding a permit so other user threads try to acquire.
+      rt::Yield();
+    }
+    sum.fetch_add(n, std::memory_order_relaxed);
+    calls.fetch_add(1, std::memory_order_relaxed);
+  }
+};
+
+void Run(void *) {
+  // A single scheduler thread makes capacity exactly one and ensures that
+  // blocked acquisition really parks a user thread rather than the OS thread.
+  Check(multicore || rt::RuntimeMaxCores() == 1,
+        "single-core cases need runtime_kthreads 1");
+  Check(NetbenchMemoryControlInit(enabled), "compiler descriptor registered");
+  Worker worker;
+  SyntheticWorker *workers[NCPU];
+  for (auto &w : workers) w = &worker;
+
+  if (toggle) {
+    rt::Semaphore entry(0), finish(0);
+    entered = &entry;
+    resume = &finish;
+    rt::Thread invocation([&] { netbench_memory_work(workers, 7); });
+    entry.Wait();
+    Check(NetbenchMemoryControlCounts().active == 1, "guard holds permit");
+    Check(NetbenchMemoryControlSetEnabled(false), "disable while body active");
+    finish.Post();
+    invocation.Join();
+    toggle = false;
+    expect_permit = false;
+    netbench_memory_work(workers, 11); // disabled entry must not acquire
+    auto c = NetbenchMemoryControlCounts();
+    Check(c.acquired == 1 && c.released == 1 && c.active == 0,
+          "active guard releases after disable; later entry bypasses hooks");
+    Check(calls == 2 && sum == 18, "toggle preserves arguments and work");
+    Check(NetbenchMemoryControlSetEnabled(true), "reenable");
+    expect_permit = true;
+    netbench_memory_work(workers, 13);
+    c = NetbenchMemoryControlCounts();
+    Check(c.acquired == 2 && c.released == 2 && c.active == 0,
+          "reenabled entry acquires and releases");
+    Check(calls == 3 && sum == 31, "reenable executes the body");
+  } else {
+    auto *sem = enabled ? MemSemaphore::GetInstance() : nullptr;
+    // Hold the only permit until every spawned thread has queued.
+    if (sem && !multicore) sem->Wait();
+    rt::WaitGroup done(kThreads);
+    for (int i = 0; i < kThreads; ++i) {
+      rt::Spawn([&, i] {
+        for (int j = 0; j < kCalls; ++j)
+          netbench_memory_work(workers, i + 1);
+        done.Done();
+      });
+    }
+    if (sem && !multicore) {
+      while (sem->QueueLength() != kThreads) rt::Yield();
+      Check(calls == 0, "no work before a permit is available");
+      sem->Post();
+    }
+    done.Wait();
+    auto c = NetbenchMemoryControlCounts();
+    const uint64_t expected = kThreads * kCalls;
+    Check(calls == expected, "every invocation executed");
+    Check(sum == kCalls * kThreads * (kThreads + 1) / 2, "arguments preserved");
+    Check(c.acquired == (enabled ? expected : 0) &&
+          c.released == c.acquired && c.active == 0, "balanced hooks");
+    if (sem) Check(sem->QueueLength() == 0, "waiter queue drained");
+  }
+  auto c = NetbenchMemoryControlCounts();
+  printf("PASS mode=%s enabled=%d calls=%lu sum=%lu acquired=%lu released=%lu active=%lu\n",
+         NetbenchMemoryControlMode(), enabled, calls.load(), sum.load(),
+         c.acquired, c.released, c.active);
+  std::exit(0);
+}
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 3) {
+    fprintf(stderr, "usage: %s CONFIG enabled|disabled|toggle|multicore\n", argv[0]);
+    return 2;
+  }
+  multicore = std::strcmp(argv[2], "multicore") == 0;
+  toggle = std::strcmp(argv[2], "toggle") == 0;
+  enabled = multicore || toggle || std::strcmp(argv[2], "enabled") == 0;
+  expect_permit = enabled;
+  if (!enabled && std::strcmp(argv[2], "disabled") != 0) return 2;
+  return runtime_init(argv[1], Run, nullptr);
+}
