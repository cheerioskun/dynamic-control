+
+class SyntheticWorker;
+
+// Called inside Shenango, before request threads start. Both builds use the
+// existing MemSemaphore singleton; the auto build also publishes its guard.
+bool NetbenchMemoryControlInit(bool enabled) noexcept;
+const char *NetbenchMemoryControlMode() noexcept;
